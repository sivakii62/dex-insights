# Copy to .env and adjust as needed; docker-compose reads this file automatically.
# Every value has a working default, so the app runs with none of these set.

# Origins the API accepts browser requests from.
DEX_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional LLM-backed chat generation. Leave disabled to run with no credentials;
# the deterministic generator answers every question either way.
DEX_CHAT_LLM_ENABLED=false
DEX_CHAT_LLM_BASE_URL=https://api.openai.com/v1
DEX_CHAT_LLM_API_KEY=
DEX_CHAT_LLM_MODEL=gpt-4o-mini
